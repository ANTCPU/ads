// app/api/upload/brand-og/route.ts
// Accepts brand OG image upload.
// Validates server-side (format, size).
// Uploads to Vercel Blob.
// Writes URL to ad_profiles.og_image_url.
//
// Coming-soon slots are blocked here too — never trust the client.

import { NextRequest, NextResponse } from 'next/server';
import { put } from '@vercel/blob';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!
);

const ALLOWED_FORMATS = ['jpg', 'jpeg', 'png'];
const MAX_BYTES       = 500 * 1024; // 500KB

export async function POST(req: NextRequest) {
  try {
    const form  = await req.formData();
    const file  = form.get('file')  as File   | null;
    const email = form.get('email') as string | null;

    if (!file || !email) {
      return NextResponse.json({ error: 'File and email required.' }, { status: 400 });
    }

    // ── Format ────────────────────────────────────────────
    const ext = file.name.split('.').pop()?.toLowerCase() ?? '';
    if (!ALLOWED_FORMATS.includes(ext)) {
      return NextResponse.json(
        { error: 'Upload JPG or PNG only.' },
        { status: 400 }
      );
    }

    // ── Size ──────────────────────────────────────────────
    if (file.size > MAX_BYTES) {
      return NextResponse.json(
        { error: `Too large — max 500KB. Yours is ${Math.round(file.size / 1024)}KB.` },
        { status: 400 }
      );
    }

    // ── Verify email exists in ad_signups ─────────────────
    const { data: signup } = await supabase
      .from('ad_signups')
      .select('email')
      .eq('email', email.trim().toLowerCase())
      .maybeSingle();

    if (!signup) {
      return NextResponse.json({ error: 'Account not found.' }, { status: 403 });
    }

    // ── Upload to Vercel Blob ─────────────────────────────
    // Deterministic path — re-upload overwrites, no orphaned files
    const safeName = email.replace(/[@.]/g, '-');
    const path     = `brands/${safeName}/og.${ext}`;

    const blob = await put(path, file, {
      access:          'public',
      addRandomSuffix: false,
    });

    // ── Write to ad_profiles ──────────────────────────────
    await supabase
      .from('ad_profiles')
      .upsert(
        { email: email.trim().toLowerCase(), og_image_url: blob.url },
        { onConflict: 'email' }
      );

    return NextResponse.json({ url: blob.url });

  } catch (e: unknown) {
    const msg = e instanceof Error ? e.message : 'Upload failed';
    console.error('Brand OG upload error:', msg);
    return NextResponse.json({ error: msg }, { status: 500 });
  }
}
